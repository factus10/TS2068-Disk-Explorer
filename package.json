{
  "name": "ts2068-disk-browser",
  "version": "1.3.7",
  "description": "Browse and extract files from vintage Timex/Sinclair disk images",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ts2068.disk-browser",
    "productName": "TS-2068 Disk Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "help/**/*"
    ],
    "fileAssociations": [
      { "ext": "img", "name": "Disk Image", "role": "Viewer" },
      { "ext": "dsk", "name": "Disk Image", "role": "Viewer" },
      { "ext": "tap", "name": "TAP File", "role": "Viewer" },
      { "ext": "tzx", "name": "TZX File", "role": "Viewer" },
      { "ext": "sna", "name": "SNA Snapshot", "role": "Viewer" },
      { "ext": "z80", "name": "Z80 Snapshot", "role": "Viewer" },
      { "ext": "scr", "name": "Screen File", "role": "Viewer" },
      { "ext": "mgt", "name": "MGT Disk Image", "role": "Viewer" }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "factus10@gmail.com"
    }
  }
}
